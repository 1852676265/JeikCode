{
  "name": "zap-webui",
  "private": true,
  "version": "1.0.13",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite\" \"electron ./electron/main.cjs\"",
    "electron": "electron ./electron/main.cjs",
    "build": "tsc --noEmit && vite build",
    "cap:sync": "vite build && cap sync ios",
    "cap:copy": "vite build && cap copy ios",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@types/ws": "^8.18.2",
    "@xterm/addon-attach": "^0.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "katex": "^0.18.7",
    "libheif-js": "^1.23.5",
    "lucide-react": "^1.52.0",
    "marked": "^12.0.2",
    "mermaid": "^12.1.0",
    "node-pty": "^1.1.0",
    "preact": "^10.24.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource/source-serif-4": "^5.2.9",
    "@preact/preset-vite": "^2.10.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^45.2.3",
    "postcss": "^8.5.29",
    "typescript": "^5.6.0",
    "vite": "^8.3.6"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.0.3"
  },
  "overrides": {
    "lightningcss": "npm:lightningcss-wasm@^1.32.0",
    "mermaid": {
      "katex": "$katex"
    },
    "diff": "^8.0.0"
  }
}
